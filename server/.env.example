# server/.env — 이 파일을 복사해서 실제 값을 채운 뒤 .env 로 저장하세요.
# .env 파일 자체는 절대 커밋(공유)하지 마세요 — 실제 키가 들어있는 파일입니다.

# OpenAI API 키 (https://platform.openai.com/api-keys 에서 발급)
OPENAI_API_KEY=sk-여기에_발급받은_키_입력
OPENAI_MODEL=gpt-4o-mini

# 공공데이터포털 인증키 (선택 — /api/public-data 프록시를 쓸 때만 필요)
# data.go.kr 마이페이지 > 개발계정 상세보기 > 일반 인증키(Encoding)
PUBLIC_DATA_API_KEY=

# ChromaDB(벡터DB) 저장 폴더 (선택 — 비워두면 기본값 server/chroma_db 사용,
# 팀원들과 같은 상대 경로를 공유하기 위한 기본값입니다. git에는 안 올라감)
# VS Code Live Server 같은 자동 새로고침 도구를 쓴다면, ChromaDB가 내부 파일을
# 계속 갱신하면서 브라우저가 자꾸(약 1초 간격) 새로고침될 수 있으니
# .vscode/settings.json의 liveServer.settings.ignoreFiles에 "server/**"를
# 추가하고 Live Server를 완전히 재시작하세요. (server/app.py 상단 주석 참고)
# 이 폴더를 팀과 공유하지 않고 개인 홈 폴더 등에 따로 두고 싶다면 아래처럼 지정:
# CHROMA_DB_DIR=/원하는/절대/경로
